# Project specific
*.png
*.jpg
# Website public assets must be tracked (hero image, etc.)
!website/public/
!website/public/**/*.png
!website/public/**/*.jpg
!website/public/**/*.jpeg
!website/public/**/*.gif
!website/public/**/*.ico
!website/public/**/*.svg
!website/public/**/*.webp
# Installer downloads - keep folder but ignore large installer files
# Upload installers to GitHub Releases instead (2GB limit vs 100MB for git)
!website/public/downloads/
!website/public/downloads/.gitkeep
website/public/downloads/*.exe
website/public/downloads/*.dmg
website/public/downloads/*.AppImage
*.vtk
*.vtu
vtk_output/
results/
*.log
